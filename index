<div class="cart-panel" id="cartPanel" onclick="if(event.target===this)closeCart()">
<div class="cart-content">
<div class="cart-head"><h2>Tu carrito</h2><button class="close" onclick="closeCart()">×</button></div>
<div id="cartItems"></div>
<div class="summary">
<div class="line"><span>Subtotal</span><strong id="subtotal">$0</strong></div>
<div class="line"><span>Descuento</span><strong id="discount">$0</strong></div>
<div class="line"><span>Total productos</span><strong id="total">$0</strong></div>
<p class="note" id="shipping">El costo de envío se coordina por WhatsApp.</p>
<button class="btn" onclick="checkout()">Preparar pedido por WhatsApp ↗</button>
</div>
</div></div>

<script>
const WA="5493813538008";
const categoriesList=["Todos","Ramos de flores","Sets de decoración","Joyeros y adornos","Espejos","Floreros y decoración"];
const productsData=[
{id:"ramo-arena",name:"Ramo Arena",cat:"Ramos de flores",price:15000,img:"RAMO ARENA.JPEG",desc:"Ramo de flores de tela realizado a mano."},
{id:"ramo-cardo",name:"Ramo Cardo",cat:"Ramos de flores",price:15000,img:"RAMO CARDO.jpg",desc:"Flores de tela con formas y texturas."},
{id:"ramo-silvestre",name:"Ramo Silvestre",cat:"Ramos de flores",price:15000,img:"RAMO SILVESTRE .JPEG",desc:"Un ramo artesanal inspirado en la naturaleza."},
{id:"ramo-trama",name:"Ramo Trama",cat:"Ramos de flores",price:15000,img:"RAMO TRAMA.JPEG",desc:"Flores de tela con textura y personalidad."},
{id:"joyero-nido",name:"Joyero Nido",cat:"Joyeros y adornos",price:3000,img:"JOYERO NIDO.JPEG",desc:"Un pequeño objeto artesanal para tus accesorios."},
{id:"set-abra",name:"Set Abra",cat:"Sets de decoración",price:null,img:"SET ABRA.JPEG",desc:"Un conjunto decorativo artesanal."},
{id:"set-botanico",name:"Set Botánico",cat:"Sets de decoración",price:25000,img:"SET BOTÁNICO.JPEG",desc:"Una composición decorativa de tonos naturales."},
{id:"set-brote",name:"Set Brote",cat:"Sets de decoración",price:25000,img:"SET BROTE.JPEG",desc:"Bandeja ovalada, florero y cuenco en forma de pétalos. No incluye flores."},
{id:"set-bruma",name:"Set Bruma",cat:"Sets de decoración",price:25000,img:"SET BRUMA.JPEG",desc:"Bandeja ovalada, florero y contenedor con tapa. No incluye flores."},
{id:"set-latido",name:"Set Latido",cat:"Sets de decoración",price:23000,img:"SET LATIDO.JPEG",desc:"Bandeja, florero y figura contemplativa. No incluye flores."},
{id:"set-loto",name:"Set Loto",cat:"Sets de decoración",price:25000,img:"SET LOTO.JPEG",desc:"Una composición artesanal para tus espacios."},
{id:"set-nudo",name:"Set Nudo",cat:"Sets de decoración",price:15000,img:"SET NUDO .JPEG",desc:"Bandeja, florero y cuenco con relieve."},
{id:"set-pausa",name:"Set Pausa",cat:"Sets de decoración",price:null,img:"SET PAUSA.JPEG",desc:"Consultanos por el precio y la disponibilidad."},
{id:"set-pensador",name:"Set Pensador",cat:"Sets de decoración",price:23000,img:"SET PENSADOR.JPEG",desc:"Un conjunto decorativo para sumar personalidad."},
{id:"set-resguardo",name:"Set Resguardo",cat:"Sets de decoración",price:null,img:"SET RESGUARDO.JPEG",desc:"Una composición decorativa artesanal."},
{id:"set-silencio",name:"Set Silencio",cat:"Sets de decoración",price:23000,img:"Set silencio.JPEG",desc:"Bandeja, florero y escultura calada. No incluye flores."},
{id:"set-silueta",name:"Set Silueta",cat:"Sets de decoración",price:null,img:"SET SILUETA .JPEG",desc:"Un conjunto artesanal para tus espacios."},
{id:"set-calma",name:"Set Calma",cat:"Sets de decoración",price:10000,img:"Set calma.JPEG",desc:"Bandeja ovalada y florero o frasco."}
];
let activeCategory="Todos";
let cart={};
try{cart=JSON.parse(localStorage.getItem("rp-cart")||"{}")||{}}catch(e){cart={}}

function showView(id){
document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));
window.scrollTo({top:0,behavior:"smooth"});
closeCart();
}
function money(n){return new Intl.NumberFormat("es-AR",{style:"currency",currency:"ARS",maximumFractionDigits:0}).format(n)}
function renderCategories(){
document.getElementById("categories").innerHTML=categoriesList.map(c=>`<button class="${c===activeCategory?"active":""}" onclick="setCategory('${c}')">${c}</button>`).join("");
}
function setCategory(c){activeCategory=c;renderCategories();renderProducts()}
function renderProducts(){
let list=productsData.filter(p=>activeCategory==="Todos"||p.cat===activeCategory);
document.getElementById("products").innerHTML=list.map(p=>`
<article class="card">
<img src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.style.opacity='.3';this.alt='Revisar nombre del archivo: ${p.img}'">
<div class="card-info"><h3>${p.name}</h3><p>${p.desc}</p>
<div class="price-row"><span class="price">${p.price==null?"Consultar precio":money(p.price)}</span><button class="add" onclick="add('${p.id}')">Agregar +</button></div></div></article>`).join("");
document.getElementById("no-products").hidden=list.length>0;
}
function save(){try{localStorage.setItem("rp-cart",JSON.stringify(cart))}catch(e){}}
function add(id){cart[id]=(cart[id]||0)+1;save();renderCart();openCart()}
function change(id,n){cart[id]=(cart[id]||0)+n;if(cart[id]<=0)delete cart[id];save();renderCart()}
function totals(){
let subtotal=0;
productsData.forEach(p=>{if(p.price!=null)subtotal+=p.price*(cart[p.id]||0)});
let discount=subtotal>70000?Math.round(subtotal*.10):0;
return{subtotal,discount,total:subtotal-discount}
}
function renderCart(){
let count=Object.values(cart).reduce((a,b)=>a+b,0);
document.getElementById("count").textContent=count;
document.getElementById("count2").textContent=count;
let selected=productsData.filter(p=>cart[p.id]>0);
document.getElementById("cartItems").innerHTML=selected.length?selected.map(p=>`
<div class="cart-item"><div><strong>${p.name}</strong><small>${p.price==null?"Precio a consultar":money(p.price)+" por unidad"}</small>
<div class="qty"><button onclick="change('${p.id}',-1)">−</button><span>${cart[p.id]}</span><button onclick="change('${p.id}',1)">+</button></div></div>
<strong>${p.price==null?"Consultar":money(p.price*cart[p.id])}</strong></div>`).join(""):'<p class="note">Todavía no agregaste productos al carrito.</p>';
let t=totals();
document.getElementById("subtotal").textContent=money(t.subtotal);
document.getElementById("discount").textContent="− "+money(t.discount);
document.getElementById("total").textContent=money(t.total);
document.getElementById("shipping").textContent=t.subtotal>70000&&t.total>=70000?"¡Cumplís las condiciones para el descuento y envío gratis en las zonas habilitadas!":"El descuento se aplica al superar $70.000; el envío gratis requiere un total de al menos $70.000 después del descuento.";
}
function openCart(){document.getElementById("cartPanel").classList.add("open");document.body.style.overflow="hidden"}
function closeCart(){document.getElementById("cartPanel").classList.remove("open");document.body.style.overflow=""}
function checkout(){
let selected=productsData.filter(p=>cart[p.id]>0);
if(!selected.length){alert("Tu carrito está vacío.");return}
let t=totals(),msg="Hola, Raíz Pacará. Quisiera consultar por este pedido:\n\n";
selected.forEach(p=>msg+=`• ${p.name} x${cart[p.id]} — ${p.price==null?"precio a confirmar":money(p.price*cart[p.id])}\n`);
msg+=`\nSubtotal de productos: ${money(t.subtotal)}\nDescuento: ${money(t.discount)}\nTotal de productos con precio confirmado: ${money(t.total)}\nEnvío: a coordinar.\n\n¿Me confirman disponibilidad y total final, por favor?`;
window.open("https://wa.me/"+WA+"?text="+encodeURIComponent(msg),"_blank");
}
renderCategories();renderProducts();renderCart();
</script>
</body>
</html>

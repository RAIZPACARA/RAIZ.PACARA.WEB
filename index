@media(max-width:850px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.navlinks{gap:12px}}
@media(max-width:620px){
 nav{flex-wrap:wrap;padding:12px 4%;gap:12px}.logo strong{font-size:19px;letter-spacing:2px}
